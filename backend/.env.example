# Sprichblitz Backend – Environment-Variablen
# Kopiere diese Datei nach .env und fülle die Werte aus.
# .env ist in .gitignore und wird NIEMALS eingecheckt.

# --- Auth (Pflicht) ---
# Generieren mit: python -m sprichblitz_backend.setup
BACKEND_AUTH_TOKEN=

# --- Verschlüsselung Per-User-Keys (Pflicht; fail-closed) ---
# Gültiger Fernet-Key (32-Byte urlsafe-base64); ohne ihn startet das Backend nicht.
# Erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠  OFF-MACHINE SICHERN: Verlust dieses Keys = der Vault ist unwiederbringlich,
#    ALLE gespeicherten Per-User-Provider-Keys sind dann verloren. Backup an einen
#    sicheren Ort (z. B. Passwortmanager), nicht nur auf dem Backend-Host.
#    Siehe docs/operations.md.
SPRICHBLITZ_SECRET_KEY=
# Optional für Key-Rotation (kommagetrennte Alt-Keys); siehe docs/operations.md:
# SPRICHBLITZ_SECRET_KEY_OLD=

# --- Provider-Keys: bewusst NICHT hier ---
# Provider-API-Keys (Anthropic/OpenAI/Gemini/OpenRouter) werden NICHT über die env
# gesetzt. Sie liegen pro Nutzer verschlüsselt im Vault und werden über
# `PUT /me/keys/{provider}` (oder die Admin-CLI `set-key`) gespeichert. Es gibt
# KEINEN env-Fallback – ein fehlender Key führt zu 412 (missing_provider_key).

# --- Logging (optional) ---
# DEBUG / INFO / WARNING / ERROR
SPRICHBLITZ_LOG_LEVEL=INFO

# --- Pfade (optional) ---
# Pfad zu config.yml; Default: <repo>/backend/config.yml
# SPRICHBLITZ_CONFIG=/absolute/path/to/config.yml
# Pfad zu config.local.yml; Default: neben config.yml
# SPRICHBLITZ_CONFIG_LOCAL=/absolute/path/to/config.local.yml
